# 1. OPERATOR INPUT — initial seeds; never print this file.
# The Access Key is opaque. Single-quote it to preserve $, # and spaces.
# After initialization, the database verifier and saved Kernel origin win.
PERIMETR_ACCESS_KEY=
PERIMETR_PUBLIC_URL=https://CHANGE_ME
KERNEL_URL=https://CHANGE_ME
KERNEL_SERVICE_TOKEN=

# 2. GENERATED MACHINE SECRETS — generated once by perimetr-install prepare.
# Escrow PERIMETR_POD_SIGNING_SECRET separately: it is required for recovery.
PERIMETR_POD_SIGNING_SECRET=
PERIMETR_POSTGRES_PASSWORD=
PERIMETR_DATABASE_URL=
UPDATER_CONTROL_TOKEN=
PERIMETR_ACCESS_KEY_HASH=

# 3. RELEASE IDENTITY — populated from the verified immutable manifest.
PERIMETR_VERSION=2.0.0
PERIMETR_IMAGE=
PERIMETR_POD_VERSION=0.1.3

# 4. OPERATIONAL DEFAULTS — local listener, bounded storage, shared helper.
PERIMETR_ENV=production
PERIMETR_LISTEN_PORT=18080
PERIMETR_COOKIE_SECURE=true
PERIMETR_SESSION_TTL_SEC=3600
PERIMETR_TRUSTED_PROXIES=127.0.0.1,::1
PERIMETR_STATE_DIR=/app/.tmp
PERIMETR_DATA_FILESYSTEM=/var/lib/perimetr-data
PERIMETR_LOGS_DIR=/app/.tmp/perimetr_logs
PERIMETR_AUDIT_MAX_ENTRIES=10000
PERIMETR_AUDIT_MAX_BYTES=67108864
PERIMETR_AUDIT_MAX_EVENT_BYTES=16384
PERIMETR_AUDIT_RETENTION_DAYS=30
PERIMETR_LOG_MAX_FILE_BYTES=5242880
PERIMETR_LOGS_MAX_TOTAL_BYTES=67108864
PERIMETR_MAX_BACKUP_UPLOAD_BYTES=134217728
PERIMETR_BACKUP_MAX_EXPANDED_BYTES=268435456
PERIMETR_BACKUP_MAX_MEMBER_BYTES=67108864
PERIMETR_BACKUP_MAX_MEMBERS=64
PERIMETR_BACKUP_MAX_RATIO=200
PERIMETR_UPDATE_CHECK_TIMEOUT_SEC=5
PERIMETR_POD_BUNDLE_SOURCE=/opt/perimetr/pod-runtime
PERIMETR_POD_CACHE_DIR=/app/.tmp/pod-runtime-cache
PERIMETR_POD_UPDATE_PUBLIC_KEY_PATH=/opt/perimetr/pod-runtime/pod-update-public-key.pem
PERIMETR_POD_REFRESH_SEC=900
PERIMETR_POD_DOWNLOAD_TIMEOUT_SEC=120
PERIMETR_POD_MAX_ARTIFACT_BYTES=335544320
PERIMETR_POD_ENROLLMENT_TTL_SEC=86400
PERIMETR_POD_OFFLINE_AFTER_SEC=90
PERIMETR_XRAY_VERSION=26.4.25
PERIMETR_XRAY_SOURCE_URL=https://github.com/XTLS/Xray-core/releases/download/v26.4.25/Xray-windows-64.zip
PERIMETR_XRAY_SHA256=9f2852563d5196396cf41be8d843de61ce108e1e398ed93e93c09976f7791629
PERIMETR_XRAY_DNS_URL=https://1.1.1.1/dns-query
PERIMETR_PROXY_VERIFICATION_URL=https://api.ipify.org?format=json
PERIMETR_DEFAULT_POD_URL=https://www.google.com
KERNEL_CACHE_PATH=/app/.tmp/kernel-cache/register.snapshot.json
KERNEL_TIMEOUT_SEC=3
KERNEL_REFRESH_SEC=60
UPDATER_HEAD_ID=perimetr
UPDATER_SERVICE_ID=perimetr
UPDATER_SOCKET_DIR=/run/exocortex
UPDATER_SOCKET_PATH=/run/exocortex/updater.sock
UPDATER_SOCKET_GID=
UPDATER_COMPOSE_PROJECT_DIR=/opt/exocortex/perimetr
UPDATER_COMPOSE_FILE=compose.production.yaml
UPDATER_COMPOSE_SERVICE=perimetr-api
UPDATER_CONTAINER_NAME=exocortex-perimetr
UPDATER_IMAGE_VARIABLE=PERIMETR_IMAGE
UPDATER_VERSION_VARIABLE=PERIMETR_VERSION
UPDATER_LOCAL_HEALTH_URL=http://127.0.0.1:18080/v1/health
UPDATER_PUBLIC_HEALTH_URL=
UPDATER_RESTORE_URL=http://127.0.0.1:18080/v1/internal/updater/restore
UPDATER_RESTORE_FIELD=archive
